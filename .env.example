# Copy to .env.local and fill in. Never commit real values.

# ── Database (Railway Postgres) ───────────────────────────────────
# Railway → wishka project → Postgres service → Variables → DATABASE_PUBLIC_URL
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── Auth (Better Auth) ────────────────────────────────────────────
# Any long random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Model names live in env on purpose: OpenAI retires models Dec 2026,
# migration must be a one-line change.
OPENAI_MODEL_TEXT=gpt-5.6-luna
OPENAI_MODEL_ASSISTANT=gpt-5-mini
OPENAI_MODEL_IMAGE=gpt-image-2

# ── Email (Resend) — auth OTP codes + transactional ───────────────
RESEND_API_KEY=
EMAIL_FROM="Wishka <hello@wishka.app>"

# ── Image storage (UploadThing) ───────────────────────────────────
# UploadThing dashboard → your app → API Keys
UPLOADTHING_TOKEN=

# ── Parsing fallbacks (optional, free tiers) ──────────────────────
FIRECRAWL_API_KEY=
JINA_API_KEY=

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
