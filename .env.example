# Copy to .env.local and fill in. Never commit real values.

# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for image re-hosting and AI quota accounting.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Model names live in env on purpose: OpenAI retires models Dec 2026,
# migration must be a one-line change.
OPENAI_MODEL_TEXT=gpt-5.6-luna
OPENAI_MODEL_ASSISTANT=gpt-5-mini
OPENAI_MODEL_IMAGE=gpt-image-2

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Wishka <hello@wishka.app>"

# ── Parsing fallbacks (optional, free tiers) ──────────────────────
FIRECRAWL_API_KEY=
JINA_API_KEY=

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects cron endpoints (keep-alive etc.). Any random string.
CRON_SECRET=
